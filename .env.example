# Copy to .env.local in each app that needs it (apps/command-center,
# apps/field-pwa, apps/vendor-portal) — Next.js only reads .env.local from
# the app's own directory, not the monorepo root. For local Supabase dev,
# run `supabase start` and copy the URL/keys it prints; for the cloud
# project, get these from the Supabase dashboard's API settings.

# Public — safe to ship to the browser. RLS is the real access boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ — bypasses RLS entirely.
# Used by: supabase/seed.ts, Edge Functions. Never imported by app code
# that runs in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used by the AI agent Edge Functions and the Command
# Copilot's server route — never sent to the client.
ANTHROPIC_API_KEY=

# Server-only, optional (vendor escalation / safety alert emails).
RESEND_API_KEY=
